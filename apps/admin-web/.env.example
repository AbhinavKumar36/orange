# Hosted Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
NODE_ENV=development

# Explicitly enable local quick-login dev buttons (LOCAL DEVELOPMENT ONLY; ignored in production)
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

