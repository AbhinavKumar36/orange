# Server Port & Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Explicit toggle to allow mock/placeholder credentials in local development
ALLOW_MOCK_SERVICES=true

# Hosted Supabase Configuration (Explicit hosted URL is required; local Supabase is prohibited)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public Anon Key (for client PostgREST queries)
SUPABASE_ANON_KEY=your_hosted_anon_key_here
# Privileged Service Role Key - Authoritative DB Access (NEVER expose to client apps)
SUPABASE_SERVICE_ROLE_KEY=your_hosted_service_role_key_here

# YouPI-PG Self-Hosted UPI & COD Gateway Configuration
YOUPI_BASE_URL=http://localhost:8080
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
YOUPI_PUBLIC_KEY=youpi_pub_test123
YOUPI_WEBHOOK_SECRET=whsec_youpi_test987654321
YOUPI_VPA=itsabhinav36@ibl
CUSTOMER_APP_URL=http://localhost:3000

# Deprecated Razorpay Privileged Configuration (Optional for backwards compatibility)
RAZORPAY_KEY_ID=rzp_test_exampleKeyId1234
RAZORPAY_KEY_SECRET=exampleSecretKeyString1234567890
RAZORPAY_WEBHOOK_SECRET=whsec_exampleWebhookSecretString9876543210

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
