{
  "name": "orange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@orange/backend-api",
    "dev:customer": "turbo run dev --filter=@orange/customer-web",
    "dev:admin": "turbo run dev --filter=@orange/admin-web",
    "lint": "turbo run lint",
    "test": "vitest run --globals --environment node apps/",
    "typecheck": "turbo run typecheck",
    "contracts:lint": "turbo run lint --filter=@orange/api-contracts",
    "adb:reverse": "adb reverse tcp:4000 tcp:4000",
    "test:db:concurrency": "node scripts/test-database-concurrency.mjs",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "turbo": "^2.4.4"
  }
}
